# Copy to .env.local (git-ignored) to override defaults.

# Dev only: where the Vite proxy forwards /api requests.
# VITE_API_TARGET=http://localhost:8000

# Production build only: absolute base URL the built app calls directly.
# Leave unset in development — the /api proxy is used instead.
# VITE_API_BASE_URL=https://underwriter.example.com
