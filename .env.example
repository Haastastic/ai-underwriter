# Copy to .env (git-ignored) and fill in. The backend loads .env at startup
# via app.backend.config.load_env_file(); real environment variables take
# precedence over anything set here.

# Anthropic API key. When unset, the backend falls back to an offline stub
# that emits a clearly-marked draft notice instead of calling a model.
ANTHROPIC_API_KEY=

# --- Optional backend overrides (defaults shown) ---
# AIU_MODELS_ROOT=models
# AIU_MODEL_VERSION=v1
# AIU_TRAINING_DATA=data/raw/cs-training.csv
# AIU_DB_PATH=underwriter.db
# AIU_LLM_MODEL=claude-opus-5
# AIU_MAX_REASONS=4
# AIU_APPROVE_BELOW=0.08
# AIU_DENY_AT_OR_ABOVE=0.30
