# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Data & model artifacts (large / regeneratable, not checked in)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/**
!models/.gitkeep

# Local SQLite databases (runtime state, not checked in)
*.db
*.sqlite3

# Frontend (app/frontend/ has its own .gitignore too)
node_modules/
app/frontend/dist/

# Secrets
.env

# Editor/OS
.vscode/
.idea/
.DS_Store
